# ─────────────────────────────────────────────────────────────
# Fjord & Cotton — environment. Copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.
# Choose an EU region for Supabase (05-norwegian-compliance.md).
# ─────────────────────────────────────────────────────────────

# Public site origin, used to build absolute URLs (return_url, callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — from Project Settings → API (or `supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (created by migration 0003).
SUPABASE_PRINT_BUCKET=print-files
SUPABASE_MOCKUP_BUCKET=mockups

# Shared secret for automation (scripts, cron) against the admin routes.
# Send it as the `x-admin-token` header. The admin UI uses a Supabase session.
ADMIN_TOKEN=change-me-in-local-and-prod

# Comma-separated allowlist. Only these addresses reach /admin, even with a valid
# Supabase session — a leaked invite still cannot publish to the shop.
ADMIN_EMAILS=hei@fjordcotton.no

# ── Stripe (build-order step 4). Hosted Stripe Checkout. ──
# Leave STRIPE_SECRET_KEY blank to run in MOCK mode: the checkout simulates the
# redirect locally so the order → paid flow is testable without Stripe.
#
# Which methods appear — card, Klarna, Apple/Google Pay — is configured in the
# Stripe dashboard, not here. Stripe does NOT offer Vipps; that needs its own
# integration (see lib/payments.ts).
STRIPE_SECRET_KEY=        # sk_test_… in test mode, sk_live_… in production
# From Developers → Webhooks → your endpoint. Without it the webhook rejects every
# call and no order becomes paid, so it is not optional in production.
STRIPE_WEBHOOK_SECRET=    # whsec_…
# Force mock on/off regardless of the key (default: mock when the key is absent).
# STRIPE_MOCK=true

# ── Gelato (build-order step 5). Self-service API key from the Gelato dashboard. ──
# Leave blank to run in MOCK mode: paid orders are "submitted" without calling
# Gelato, so the fulfilment flow is testable without an account.
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET=     # optional: verifies the status webhook
# GELATO_MOCK=true         # force mock on/off regardless of the API key

# Shared secret protecting the fulfilment retry cron (/api/cron/gelato).
CRON_SECRET=change-me

# ── Email / receipts (build-order step 6). ──
# Leave RESEND_API_KEY blank to run in MOCK mode (receipts are logged, not sent).
RESEND_API_KEY=
EMAIL_FROM="Fjord & Cotton <kvittering@fjordcotton.no>"   # must be a verified Resend domain
OPS_ALERT_EMAIL=hei@fjordcotton.no                        # Gelato manual-review alerts
# EMAIL_MOCK=true          # force mock on/off regardless of the API key

# VAT registration is pending. Keep false until the confirmation arrives
# (05-norwegian-compliance.md — charging VAT while unregistered is an offence).
VAT_REGISTERED=false

# Launch Norway-only (default). Set true only after IOSS / destination VAT is
# handled, to open Sweden/Denmark/Finland at checkout (05-norwegian-compliance.md).
CHECKOUT_NORDICS=false
